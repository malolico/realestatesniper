#!/bin/sh
# Factory Git Hardening — versioned pre-commit
# Invokes staged-path guard only. No mutations. No heavy tests.

ROOT="$(git rev-parse --show-toplevel)" || exit 2
cd "$ROOT" || exit 2

if ! command -v node >/dev/null 2>&1; then
  echo "COMMIT BLOCKED — node executable not found in PATH" >&2
  exit 2
fi

if [ ! -f "scripts/git/guardStagedForbiddenPaths.js" ]; then
  echo "COMMIT BLOCKED — guard scripts/git/guardStagedForbiddenPaths.js missing" >&2
  exit 2
fi

exec node scripts/git/guardStagedForbiddenPaths.js
